# Lab 09 – Task: Installing and Exploring nginx

# 1. Update package list
$ sudo apt update
Hit:1 http://archive.ubuntu.com/ubuntu jammy InRelease
Hit:2 http://security.ubuntu.com/ubuntu jammy-security InRelease
Reading package lists... Done

# 2. Search for nginx package
$ sudo apt search nginx
nginx/jammy 1.18.0-6ubuntu14.4 amd64
  high performance web server
nginx-common/jammy 1.18.0-6ubuntu14.4 all
  small, powerful, scalable web/proxy server

# 3. Show nginx dependencies
$ apt-cache depends nginx
nginx
 Depends: nginx-common
 Depends: libc6
 Depends: libpcre3
 Depends: libssl3
 Depends: zlib1g

# 4. Install nginx
$ sudo apt install nginx
Reading package lists... Done
Building dependency tree... Done
The following NEW packages will be installed:
  nginx nginx-common nginx-core
After this operation, 5,900 kB of additional disk space will be used.
Do you want to continue? [Y/n] Y
Setting up nginx (1.18.0-6ubuntu14.4) ...
Processing triggers for man-db (2.10.2) ...

# 5. Verify nginx installation
$ nginx -v
nginx version: nginx/1.18.0 (Ubuntu)

# 6. Check nginx service status
$ sudo systemctl status nginx
● nginx.service - A high performance web server
     Loaded: loaded (/lib/systemd/system/nginx.service; enabled)
     Active: active (running)
     Status: "Running, listening on port 80"

# 7. Remove nginx
$ sudo apt remove nginx
Removing nginx (1.18.0-6ubuntu14.4) ...
Processing triggers for man-db (2.10.2) ...

# 8. Remove nginx configuration files (optional)
$ sudo apt purge nginx
Purging configuration files for nginx (1.18.0-6ubuntu14.4) ...
